    Attachment : Integer;
    MessageDataColumns : many MessageDataColumn;
    RecipientCollection : many Recipient;
  };

  @cds.external : true
  @cds.persistence.skip : true
  @open : true
  entity AlertManagements {
    key Code : Integer not null;
    Name : String;
    Type : AlertManagementTypeEnum;
    Priority : AlertManagementPriorityEnum;
    Active : BoYesNoEnum;
    Param : String;
    QueryID : Integer;
    FrequencyType : AlertManagementFrequencyType;
    DayOfExecution : Integer;
    ExecutionTime : Time;
    @odata.Precision : 0
    @odata.Type : 'Edm.DateTimeOffset'
    LastExecutionDate : DateTime;
    LastExecutionTime : Integer;
    @odata.Precision : 0
    @odata.Type : 'Edm.DateTimeOffset'
    NextExecutionDate : DateTime;
    NextExecutionTime : Time;
    SaveHistory : BoYesNoEnum;
    FrequencyInterval : Integer;
    AlertManagementRecipients : many AlertManagementRecipient;
    AlertManagementDocuments : many AlertManagementDocument;
  } actions {
    action GetAlertManagementList() returns many AlertManagementParams;
  };

