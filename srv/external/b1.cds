    PaymentTermsType : Association to one PaymentTermsTypes on PaymentTermsType.GroupNumber = PaymentGroupCode;
    SalesPerson : Association to one SalesPersons on SalesPerson.SalesEmployeeCode = SalesPersonCode;
    ShippingType : Association to one ShippingTypes on ShippingType.Code = TransportationCode;
    FactoringIndicator : Association to one FactoringIndicators on FactoringIndicator.IndicatorCode = Indicator;
    User : Association to one Users on User.InternalKey = UserSign;
    Forms1099 : Association to one Forms1099 on Forms1099.FormCode = Form1099;
    WizardPaymentMethod : Association to one WizardPaymentMethods on WizardPaymentMethod.PaymentMethodCode = PaymentMethod;
    PaymentBlock2 : Association to one PaymentBlocks on PaymentBlock2.AbsEntry = PaymentBlockEntry;
    CentralBankIndicator2 : Association to one CentralBankIndicator on CentralBankIndicator2.Indicator = CentralBankIndicator;
    Project2 : Association to one Projects on Project2.Code = Project;
    EmployeeInfo : Association to one EmployeesInfo on EmployeeInfo.EmployeeID = DocumentsOwner;
    Country : Association to one Countries on Country.Code = PayToBankCountry;
    BusinessPlace : Association to one BusinessPlaces on BusinessPlace.BPLID = BPL_IDAssignedToInvoice;
    UserLanguage : Association to one UserLanguages on UserLanguage.Code = LanguageCode;
    NFModel : Association to one NFModels on NFModel.AbsEntry = SequenceModel;
    ChartOfAccount : Association to one ChartOfAccounts on ChartOfAccount.Code = ControlAccount;
    TaxWebSite : Association to one TaxWebSites on TaxWebSite.AbsEntry = ETaxWebSite;
    Branch : Association to one Branches on Branch.Code = RequesterBranch;
    Department : Association to one Departments on Department.Code = RequesterDepartment;
    POSDailySummary : Association to one POSDailySummary on POSDailySummary.AbsEntry = POSDailySummaryNo;
    CIGCode : Association to one CIGCodes on CIGCode.AbsEntry = Cig;
    CUPCode : Association to one CUPCodes on CUPCode.AbsEntry = Cup;
    JournalEntry : Association to one JournalEntries on JournalEntry.JdtNum = TransNum;
    LandedCost : Association to one LandedCosts on LandedCost.DocEntry = ImportFileNum;
  } actions {
    action Cancel();
    action Close();
    action Reopen();
    action CreateCancellationDocument() returns PurchaseQuotations;
  };

