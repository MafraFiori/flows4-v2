  @cds.external : true
  @cds.persistence.skip : true
  @open : true
  entity UserDefaultGroups {
    key Code : String not null;
    Name : String;
    Warehouse : String;
    SalesEmployee : Integer;
    BPforInvoicePayment : String;
    CashAccount : String;
    CheckingAcct : String;
    PrintReceipt : BoPrintReceiptEnum;
    PrintInvoiceandPaymentinS : BoYesNoEnum;
    WindowsColor : Integer;
    Address : String;
    Country : String;
    PrintingHeader : String;
    PhoneNumber1 : String;
    PhoneNumber2 : String;
    FaxNumber : String;
    eMail : String;
    AddressinForeignLanguage : String;
    PrintingHeaderInForeignLangu : String;
    PhoneNumber1ForeignLang : String;
    PhoneNumber2ForeignLang : String;
    FaxNumberForeignLang : String;
    DefaultTaxCode : String;
    AdditionalIdNumber : String;
    UserSignature : Integer;
    UseTax : BoYesNoEnum;
    UseWarehouseAddressinAPD : BoYesNoEnum;
    BPLID : Integer;
    AssetInDoc : BoYesNoEnum;
    LanguageCode : BoSuppLangs;
    DefaultDocuments : many DefaultDocument;
    DefaultCreditCards : many DefaultCreditCard;
    Warehouse2 : Association to one Warehouses on Warehouse2.WarehouseCode = Warehouse;
    SalesPerson : Association to one SalesPersons on SalesPerson.SalesEmployeeCode = SalesEmployee;
    BusinessPartner : Association to one BusinessPartners on BusinessPartner.CardCode = BPforInvoicePayment;
    Country2 : Association to one Countries on Country2.Code = Country;
    SalesTaxCode : Association to one SalesTaxCodes on SalesTaxCode.Code = DefaultTaxCode;
    User : Association to one Users on User.InternalKey = UserSignature;
    BusinessPlace : Association to one BusinessPlaces on BusinessPlace.BPLID = BPLID;
    UserLanguage : Association to one UserLanguages on UserLanguage.Code = LanguageCode;
  };

  @cds.external : true
  @cds.persistence.skip : true
  entity ActivitySubjects {
    key Code : Integer not null;
    Description : String;
    ActivityType : Integer;
    IsActive : BoYesNoEnum;
    ActivityType2 : Association to one ActivityTypes on ActivityType2.Code = ActivityType;
    Contacts : Association to many Contacts {  };
    Activities : Association to many Activities {  };
  };

  @cds.external : true
  @cds.persistence.skip : true
  entity Messages {
