    action Reopen();
    action CreateCancellationDocument() returns PurchaseQuotations;
  };

  @cds.external : true
  @cds.persistence.skip : true
  entity DepreciationAreas {
    key Code : String not null;
    Description : String;
    PostingOfDepreciation : PostingOfDepreciationEnum;
    RetirementMethod : RetirementMethodEnum;
    AreaType : AreaTypeEnum;
    DerivedArea : String;
    MainBookingArea : BoYesNoEnum;
    DirectRevenuePosting : BoYesNoEnum;
    TaxCreditControl : BoYesNoEnum;
    TaxType : Integer;
    BPForTaxCorrection : String;
    ItemForTaxCorrection : String;
    UsageForTaxCorrection : Integer;
    AssetRetirement : Association to many AssetRetirement {  };
    AssetTransfer : Association to many AssetTransfer {  };
    AssetRevaluations : Association to many AssetRevaluations {  };
    AssetManualDepreciation : Association to many AssetManualDepreciation {  };
    AssetCapitalization : Association to many AssetCapitalization {  };
    AssetCapitalizationCreditMemo : Association to many AssetCapitalizationCreditMemo {  };
    SalesTaxAuthoritiesType : Association to one SalesTaxAuthoritiesTypes on SalesTaxAuthoritiesType.Numerator = TaxType;
    BusinessPartner : Association to one BusinessPartners on BusinessPartner.CardCode = BPForTaxCorrection;
    Item : Association to one Items on Item.ItemCode = ItemForTaxCorrection;
    NotaFiscalUsage : Association to one NotaFiscalUsage on NotaFiscalUsage.ID = UsageForTaxCorrection;
  };

  @cds.external : true
  @cds.persistence.skip : true
