<mvc:View xmlns:core="sap.ui.core" controllerName="flow4.Apps.Login.Controller.Login" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" width="100%">
    <Page id="loginPage" showHeader="false" enableScrolling="false" class="backGround figLoginPage">
        <content>
            <VBox id="loginContainer" class="figLoginContainer">
                <HBox id="loginStage" class="figLoginStage" justifyContent="Center" alignItems="Stretch" fitContainer="true">
                    <VBox id="visualPane" class="figVisualPane" justifyContent="Center" alignItems="Center">
                        <VBox id="visualOverlay" class="figVisualOverlay">
                            <Image id="visualLogo" src="Imagens/layers.png" class="figVisualLogo" decorative="false"/>
                        </VBox>
                    </VBox>

                    <VBox id="formPane" class="figFormPane" justifyContent="Center">
                        <VBox id="formCard" class="figFormCard">
                            <Title id="loginTitle" text="Login" class="figFormTitle" level="H2"/>
                            <Text id="loginSubtitle" text="Acesse com seu usuário para continuar no portal." class="figFormSubtitle"/>

                            <VBox id="formFields" class="figFormFields">
                                <Text id="companyLabel" text="Empresa" class="figInputLabel"/>
                                <ComboBox
                                    id="dbo"
                                    placeholder="Empresa"
                                    items="{/Empresas}"
                                    width="100%"
                                    class="figInput"
                                    change="onChangeLogicalTransaction">
                                    <core:Item id="companyItemTemplate" key="{id}" text="{name}">
                                        <core:customData>
                                            <core:CustomData key="url" value="{url}"/>
                                            <core:CustomData key="db" value="{db}"/>
                                        </core:customData>
                                    </core:Item>
                                </ComboBox>
                                <Text id="loginLabel" text="Login" class="figInputLabel"/>
                                <Input id="Usuario" placeholder="Usuário" width="100%" class="figInput"/>
                                <Input id="Senha" placeholder="Senha" width="100%" class="figInput" type="Password" submit="onEntra"/>
                            </VBox>

                            <VBox id="loginActions" class="figActions">
                                <Button id="ok" text="Entrar" type="Emphasized" class="figPrimaryButton" width="100%" press="onEntra"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox id="loadingPane" class="figLoadingPane" visible="false" justifyContent="Center" alignItems="Center">
                        <BusyIndicator id="loadingIndicator" class="figBusy" size="3rem"/>
                        <Text id="loadingText" text="Validando acesso..." class="figLoadingText"/>
                    </VBox>
                </HBox>
            </VBox>
        </content>
        <footer>
            <Toolbar id="footerToolbar" design="Transparent" class="figFooterToolbar">
                <ToolbarSpacer id="footerSpacerLeft"/>
                <Text id="footerCopyright" text="© 2026 FLOWS 4. Todos os direitos reservados." class="devFor"/>
                <ToolbarSpacer id="footerSpacerRight"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
