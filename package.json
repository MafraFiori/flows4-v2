{
  "scripts": {
    "start": "cds watch",
    "deploy:pg": "cds deploy --to postgres",
    "watch-flows4": "cds watch --open flows4/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@cap-js/postgres": "^2.3.0",
    "@sap/cds": "^9.9.1",
    "pg": "^8.21.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres"
      },
      "b1": {
        "kind": "odata",
        "model": "srv/external/b1"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.13.0"
  }
}